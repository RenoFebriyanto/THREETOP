# Auto Balance Monitor settings (Rupiah)
DIGIFLAZZ_BALANCE_WARNING_THRESHOLD=200000
DIGIFLAZZ_BALANCE_CRITICAL_THRESHOLD=100000
DIGIFLAZZ_DEPOSIT_TARGET_AMOUNT=200000

# Required for the scheduled endpoint and Telegram notifications.
# Generate a long random value for CRON_SECRET. Never expose it in client code.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Digiflazz buyer credentials. Use the production API key for Production.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

# Duitku merchant credentials.
# Set DUITKU_IS_PRODUCTION=false while testing in Sandbox.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false
